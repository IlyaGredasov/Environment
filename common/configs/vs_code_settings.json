{
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "files.autoSave": "afterDelay",
    "terminal.integrated.allowedLinkSchemes": [
        "file",
        "http",
        "https",
        "mailto",
        "vscode",
        "vscode-insiders",
        "docker-desktop"
    ],
    "cmake.automaticReconfigure": false,
    "cmake.buildBeforeRun": false,
    "cmake.configureOnEdit": false,
    "cmake.configureOnOpen": false,
    "explorer.confirmDelete": false,
    "C_Cpp.intelliSenseEngine": "disabled",
    "terminal.integrated.tabs.defaultColor": "terminal.ansiBlack",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit",
            "source.fixAll.ruff": "explicit"
        }
    },
    "ruff.lint.enable": true,
    "workbench.startupEditor": "none",
    "chatgpt.localeOverride": null,
    "C_Cpp.clang_format_sortIncludes": true,
    "C_Cpp.clang_format_style": "file: ~/Programming/C++/.clang-format",
    "C_Cpp.default.intelliSenseMode": "linux-clang-x64",
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_fallbackStyle": "",
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "cmake.useVsDeveloperEnvironment": "never",
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.initialHint": false,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "workbench.editor.empty.hint": "hidden",
    "python.analysis.typeCheckingMode": "basic",
    "workbench.colorTheme": "RailsCasts Theme",
    "chat.viewSessions.orientation": "stacked",
    "chat.disableAIFeatures": true,
    "security.workspace.trust.untrustedFiles": "open",
    "chatgpt.followUpQueueMode": "steer",
    "redhat.telemetry.enabled": false,
    "python.analysis.autoImportCompletions": true,
    "python.analysis.enableParallelIndexing": true,
    "python.analysis.languageServerMode": "light",
    "yaml.disableSchemaDetection": [],
    "python.analysis.autoFormatStrings": true,
    "[dockercompose]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-containers"
    },
    "python.analysis.diagnosticMode": "workspace",
    "git.suggestSmartCommit": false,
    "window.zoomLevel": -1.5,
    "yaml.schemaStore.enable": false,
    "explorer.confirmDragAndDrop": false,
    "terminal.integrated.suggest.enabled": false,
    "terminal.integrated.suggest.inlineSuggestion": "off",
    "window.restoreWindows": "none"
}
